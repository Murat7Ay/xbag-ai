<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Murat Ay</Authors>
    <Copyright>Copyright (c) Murat Ay</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Murat7Ay/extensions-ai-testing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Murat7Ay/extensions-ai-testing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ai;llm;testing;test-doubles;fake;mock;ichatclient;microsoft-extensions-ai;agent-framework;aiagent;xunit;nunit;mstest</PackageTags>
    <Version>0.1.0-preview.1</Version>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Only projects under src/ opt in to packing. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
