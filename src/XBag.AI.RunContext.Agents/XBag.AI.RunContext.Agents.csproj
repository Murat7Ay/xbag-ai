<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>XBag.AI.RunContext.Agents</PackageId>
    <Version>0.1.0-preview.1</Version>
    <RootNamespace>XBag.AI.RunContext.Agents</RootNamespace>
    <Title>XBag.AI.RunContext.Agents</Title>
    <Description>Microsoft Agent Framework glue for XBag.AI.RunContext: AgentRunOptions.WithRunContext and AIAgentBuilder.UseRunContext give every agent run a typed user / tenant / credential context that its tools, context providers, sub-agents and HTTP/MCP calls can read, buffered and streaming. Not affiliated with Microsoft.</Description>
    <PackageTags>ai;llm;agents;agent-framework;tools;identity;multi-tenant;on-behalf-of;mcp;microsoft-extensions-ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XBag.AI.RunContext\XBag.AI.RunContext.csproj" />
    <!-- Microsoft.Agents.AI for AIAgentBuilder; AgentRunOptions, DelegatingAIAgent and CurrentRunContext are in its abstractions. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.24.0" />
  </ItemGroup>

</Project>
