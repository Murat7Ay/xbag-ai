<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>XBag.Agents.Stores.Redis.Workflows</PackageId>
    <Version>0.1.0-preview.2</Version>
    <RootNamespace>XBag.Agents.Stores.Redis.Workflows</RootNamespace>
    <Title>XBag.Agents.Stores.Redis.Workflows</Title>
    <Description>A JsonCheckpointStore for Microsoft Agent Framework workflows on Redis (StackExchange.Redis): a sorted set per session keeps commit order, checkpoint JSON stored verbatim, atomic Lua writes, optional TTL, Redis Cluster friendly. Not affiliated with Microsoft.</Description>
    <PackageTags>ai;agents;agent-framework;workflows;checkpoint;jsoncheckpointstore;redis;stackexchange-redis;persistence</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.24.0" />
    <!-- Floor: the last 2.x line, so 2.x and 3.x apps can both use the package (tests run on 3.x). -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
  </ItemGroup>

</Project>
