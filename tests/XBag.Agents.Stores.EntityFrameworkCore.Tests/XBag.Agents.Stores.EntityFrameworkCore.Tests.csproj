<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- MAAI001: AgentSessionStore and ChatHistoryProvider.InvokedContext's constructor are [Experimental]. -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- The real Microsoft pipeline the stores are proven against. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.24.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XBag.Agents.Stores.EntityFrameworkCore\XBag.Agents.Stores.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\XBag.Agents.Stores.EntityFrameworkCore.Workflows\XBag.Agents.Stores.EntityFrameworkCore.Workflows.csproj" />
    <ProjectReference Include="..\..\src\XBag.AI.Testing\XBag.AI.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contract tests shared with the Redis stores. -->
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.AI" />
  </ItemGroup>

</Project>
